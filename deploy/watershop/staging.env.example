# Installed as /home/jmacd/observatory/env/staging.env with mode 0600.
# Pin the accepted branch build by digest, never by a mutable tag.
MENDO_IMAGE=ghcr.io/jmacd/mendo-codebook-observatory@sha256:REPLACE_ME
MENDO_ARCHIVE_ROOT=/home/shared/observatory/staging/archive
# Set from archive.json after explicit staging archive initialization.
MENDO_STAGING_ARCHIVE_ID=REPLACE_ME
MENDO_RELEASE_WORK_ROOT=/home/jmacd/observatory/releases
MENDO_S3_ENDPOINT=http://localhost:9000
MENDO_S3_BUCKET=mendo-releases
MENDO_S3_REGION=us-east-1
MENDO_S3_PREFIX=staging
MENDO_RELEASE_CHANNEL=staging

# Supplied by ignored Terraform variables. Do not commit values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
