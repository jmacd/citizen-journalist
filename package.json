{
  "name": "mendo-codebook",
  "version": "1.0.0",
  "description": "Evidence-grade retrieval and comparison of Mendocino County coastal code",
  "type": "module",
  "scripts": {
    "build:case-db": "node --no-warnings scripts/build-case-database.mjs",
    "build:boundary-comparison": "node scripts/build-boundary-comparison.mjs",
    "build:casebook": "node scripts/build-casebook-data.mjs",
    "build:explorer": "node scripts/build-explorer-data.mjs",
    "explorer": "npm run build:explorer && npm run build:casebook && node scripts/serve-explorer.mjs",
    "chat": "npm run build:case-db && npm run build:casebook && agents/.venv/bin/python -m mendo_agents.chat --repo-root .",
    "workbench": "agents/.venv/bin/python -m mendo_agents.workbench --repo-root . --allow-unauthenticated-loopback",
    "fetch": "node scripts/fetch-municode.mjs",
    "fetch:pra-docs": "node scripts/fetch-nextrequest-documents.mjs",
    "fetch:section": "node scripts/fetch-section.mjs",
    "history:division-ii": "node scripts/history-division.mjs",
    "inventory:division-ii": "node scripts/inventory-division.mjs",
    "inventory:pra-docs": "node scripts/inventory-nextrequest-documents.mjs",
    "inspect:govaccess": "node scripts/inspect-govaccess-url.mjs",
    "query:case": "node --no-warnings scripts/query-case.mjs",
    "search:pra": "node scripts/search-nextrequest.mjs",
    "test:agents": "agents/.venv/bin/pytest agents/tests",
    "test:observatory": "observatory/.venv/bin/pytest observatory/tests",
    "test:all": "npm test && npm run test:agents && npm run test:observatory",
    "trace:section": "node scripts/trace-section-history.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmacd/mendo-codebook.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jmacd/mendo-codebook/issues"
  },
  "homepage": "https://github.com/jmacd/mendo-codebook#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "html-to-text": "^10.0.1",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "yaml": "^2.9.0"
  }
}
