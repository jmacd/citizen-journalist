[Unit]
Description=Mendo Observatory private evidence Workbench

[Service]
Type=simple
WorkingDirectory=/home/jmacd/observatory/app
EnvironmentFile=/home/jmacd/observatory/env/workbench.env
ExecStart=/home/jmacd/observatory/agents-venv/bin/mendo-workbench --repo-root /home/jmacd/observatory/app --host ${MENDO_WORKBENCH_HOST} --port 4180 ${MENDO_WORKBENCH_EXTRA_ARGS}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryAccounting=yes
MemoryHigh=1536M
MemoryMax=2048M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
