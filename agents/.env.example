# The default scripted provider requires no credentials.
MENDO_MODEL_PROVIDER=scripted
MENDO_CASE_ID=UM_2025-0004
MENDO_MAX_ITERATIONS=12
MENDO_MAX_RESEARCH_ROUNDS=2
# MENDO_CHECKPOINT_ROOT=/data/checkpoints
# MENDO_RUN_ROOT=/data/runs
# Use JSON only for a single-replica Azure Files deployment.
# MENDO_RESEARCH_QUEUE_PATH=/data/research-queue.json

# Ollama reads OLLAMA_HOST and OLLAMA_MODEL when selected.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Microsoft Foundry configuration.
# FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/example
# The account's OpenAI v1 endpoint can be used when project inference is not enabled.
# FOUNDRY_OPENAI_BASE_URL=https://example.openai.azure.com/openai/v1/
# FOUNDRY_MODEL=your-deployment-name
# FOUNDRY_REASONING_EFFORT=low
# FOUNDRY_VERBOSITY=low
# FOUNDRY_MAX_OUTPUT_TOKENS=4000

# OpenTelemetry. Sensitive prompts, responses, arguments, and results stay off.
ENABLE_SENSITIVE_DATA=false
# OTEL_SERVICE_NAME=mendo-government-observatory
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
