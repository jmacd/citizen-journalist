deploy_observatory = false
deploy_workbench   = false
observatory_identity_enabled = false
workbench_identity_enabled   = false

observatory_revision = "0000000000000000000000000000000000000000"

watershop_host                 = "watershop"
watershop_user                 = "jmacd"
watershop_ssh_private_key_path = "~/.ssh/id_ed25519"
watershop_host_key             = "ssh-ed25519 REPLACE_WITH_PINNED_HOST_PUBLIC_KEY"

# Leave empty for a new staging archive. Set the existing archive.json UUID
# before the first apply when adopting an already initialized staging archive.
observatory_archive_id = ""

minio_endpoint       = "http://localhost:9000"
minio_region         = "us-east-1"
minio_release_bucket = "mendo-releases"
minio_access_key     = "REPLACE_ME"
minio_secret_key     = "REPLACE_ME"
