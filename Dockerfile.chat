FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MENDO_REPO_ROOT=/app \
    MENDO_CASE_ID=UM_2025-0004 \
    MENDO_MODEL_PROVIDER=scripted \
    MENDO_CHECKPOINT_ROOT=/data/checkpoints \
    MENDO_RUN_ROOT=/data/runs

WORKDIR /app

COPY agents/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir -r /tmp/requirements.lock

COPY agents/pyproject.toml ./agents/pyproject.toml
COPY agents/src ./agents/src
COPY agents/organization ./agents/organization
RUN python -m pip install --no-cache-dir -e agents --no-deps

COPY .github/skills ./.github/skills
COPY web ./web
COPY captures/cases/UM_2025-0004/casebook.sqlite \
  ./captures/cases/UM_2025-0004/casebook.sqlite

RUN useradd --create-home --uid 10001 mendo \
    && mkdir -p /data/checkpoints /data/runs \
    && chown -R mendo:mendo /data

USER mendo
EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4173/api/health', timeout=3)"

CMD ["python", "-m", "mendo_agents.chat", "--repo-root", "/app", \
     "--host", "0.0.0.0", "--port", "4173"]
